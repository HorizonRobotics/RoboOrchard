<?xml version="1.0"?>
<package format="3">
  <name>robo_orchard_hexfellow_ros2</name>
  <version>0.0.0</version>
  <description>Optional HexFellow planar pose feedback and Twist adapter.</description>
  <maintainer email="yiwei.jin@horizon.auto">Yiwei Jin</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>hex_device_ros_wrapper</exec_depend>
  <exec_depend>hex_bridge</exec_depend>
  <exec_depend>hex_device_msgs</exec_depend>
  <exec_depend>robo_orchard_teleop_ros2</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>robo_orchard_teleop_msg_ros2</exec_depend>
